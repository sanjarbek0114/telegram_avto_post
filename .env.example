# Bu faylni .env deb nusxalang (lokal sinov uchun). GitHub'da esa Settings > Secrets ga qo'ying.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@kanal_nomi
# Sifat nazoratidan o'tmagan post haqida xabar boradigan admin chat (ixtiyoriy)
TELEGRAM_ADMIN_CHAT_ID=

# Ixtiyoriy sozlamalar
# Bo'sh qolsa eng yangi Gemini Flash matn/rasm modeli avtomatik tanlanadi
TEXT_MODEL=
IMAGE_MODEL=
ELEVENLABS_MODEL=eleven_v3
DRY_RUN=0
